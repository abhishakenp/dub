# Local self-host dev env for the Dub fork (ShipFast). Generated by build session.
# NOT for production. Secrets here are throwaway local dev values.

# ── Core secrets ────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=<generate-with-crypto-randomBytes-32>
NEXTAUTH_URL=http://localhost:8888
CRON_SECRET=<generate-with-crypto-randomBytes-32>
ENCRYPTION_KEY=<generate-with-crypto-randomBytes-32>
UNSUBSCRIBE_TOKEN_SECRET=<generate-with-crypto-randomBytes-32>

# ── MySQL (via docker-compose: mysql:8 + ps-http-sim proxy) ──────────────────
DATABASE_URL="mysql://root:@localhost:3306/planetscale"
PLANETSCALE_DATABASE_URL="http://root:unused@localhost:3900/planetscale"

# ── Upstash Redis (via serverless-redis-http shim over local Redis) ──────────
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=dev_srh_token

# ── Upstash QStash (self-host shim — TBD Phase D) ────────────────────────────
QSTASH_URL=http://localhost:8080
QSTASH_TOKEN=dev_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_dev_current
QSTASH_NEXT_SIGNING_KEY=sig_dev_next

# ── Tinybird (self-host shim — TBD Phase C) ──────────────────────────────────
TINYBIRD_API_KEY=dev_tinybird_token
TINYBIRD_API_URL=http://localhost:7181

# ── Email (Mailhog: SMTP 1025, UI 8025) ──────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=smtpUser
SMTP_PASSWORD=smtpPassword

# ── Storage (MinIO — S3 compatible, Phase B) ─────────────────────────────────
STORAGE_ACCESS_KEY_ID=dubminio
STORAGE_SECRET_ACCESS_KEY=dubminio123
STORAGE_ENDPOINT=http://localhost:9002
STORAGE_BASE_URL=http://localhost:9002/dub-assets
STORAGE_PUBLIC_BUCKET=dub-assets
STORAGE_PRIVATE_BUCKET=dub-private
